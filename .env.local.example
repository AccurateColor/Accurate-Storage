# Project Settings -> Data API in the Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings -> Data API -> service_role key (NOT the anon key).
# Server-only — never NEXT_PUBLIC_. Required for signup (creating a new
# organization + its first admin login) and for admin-provisioned team
# member logins (Settings > Team Management > Set Password). See
# src/lib/supabase/admin.ts's own comment for the full list of callers and
# why each one needs it.
SUPABASE_SERVICE_ROLE_KEY=
